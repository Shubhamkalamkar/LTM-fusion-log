{
  "info": {
    "name": "Oracle Fusion Cloud & OIC Failure Monitoring API",
    "_postman_id": "9fe294b8-064c-4aa3-bf47-oracle-monitor",
    "description": "Postman Collection v2.1 for the Oracle Fusion Cloud & OIC Job Failure Monitoring Web Application.\n\nSwitch `baseUrl` collection variable between:\n- Local Express Runner: http://localhost:3000/api (or http://localhost:3000)\n- AWS API Gateway: https://<api-id>.execute-api.<region>.amazonaws.com/prod",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Dashboard",
      "item": [
        {
          "name": "Get Dashboard Summary (All KPIs)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/dashboard/summary",
              "host": ["{{baseUrl}}"],
              "path": ["dashboard", "summary"]
            }
          }
        },
        {
          "name": "Get Dashboard Summary (Filtered by Module & Date)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/dashboard/summary?module=Supply Chain&dateFrom=2026-11-25&dateTo=2026-11-25",
              "host": ["{{baseUrl}}"],
              "path": ["dashboard", "summary"],
              "query": [
                { "key": "module", "value": "Supply Chain" },
                { "key": "dateFrom", "value": "2026-11-25" },
                { "key": "dateTo", "value": "2026-11-25" }
              ]
            }
          }
        },
        {
          "name": "Get Dashboard Metadata & Store Mode",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/dashboard/metadata",
              "host": ["{{baseUrl}}"],
              "path": ["dashboard", "metadata"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Oracle Fusion Jobs",
      "item": [
        {
          "name": "List Fusion Job Executions (Paginated)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/fusion/jobs?page=1&limit=15&sortBy=start_time&sortOrder=desc",
              "host": ["{{baseUrl}}"],
              "path": ["fusion", "jobs"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "15" },
                { "key": "sortBy", "value": "start_time" },
                { "key": "sortOrder", "value": "desc" }
              ]
            }
          }
        },
        {
          "name": "Scenario 3 - Filter Critical Failed Fusion Jobs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/fusion/jobs?status=FAILED&severity=Critical",
              "host": ["{{baseUrl}}"],
              "path": ["fusion", "jobs"],
              "query": [
                { "key": "status", "value": "FAILED" },
                { "key": "severity", "value": "Critical" }
              ]
            }
          }
        },
        {
          "name": "List Failed Fusion Jobs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/fusion/jobs/failed",
              "host": ["{{baseUrl}}"],
              "path": ["fusion", "jobs", "failed"]
            }
          }
        },
        {
          "name": "Export Failed Fusion Jobs (CSV)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/fusion/jobs/failed?format=csv",
              "host": ["{{baseUrl}}"],
              "path": ["fusion", "jobs", "failed"],
              "query": [
                { "key": "format", "value": "csv" }
              ]
            }
          }
        },
        {
          "name": "Scenario 1 - Get Fusion Execution FUS1002 (Create Accounting)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/fusion/jobs/FUS1002",
              "host": ["{{baseUrl}}"],
              "path": ["fusion", "jobs", "FUS1002"]
            }
          }
        },
        {
          "name": "Get Fusion Execution FUS1006 (Potential Time-Window Correlation)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/fusion/jobs/FUS1006",
              "host": ["{{baseUrl}}"],
              "path": ["fusion", "jobs", "FUS1006"]
            }
          }
        }
      ]
    },
    {
      "name": "3. OIC Integrations",
      "item": [
        {
          "name": "List OIC Integration Executions (Paginated)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/oic/integrations?page=1&limit=15&sortBy=start_time&sortOrder=desc",
              "host": ["{{baseUrl}}"],
              "path": ["oic", "integrations"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "15" },
                { "key": "sortBy", "value": "start_time" },
                { "key": "sortOrder", "value": "desc" }
              ]
            }
          }
        },
        {
          "name": "Filter OIC Failures Targeting Banking System (DS06)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/oic/integrations?status=FAILED&target=DS06",
              "host": ["{{baseUrl}}"],
              "path": ["oic", "integrations"],
              "query": [
                { "key": "status", "value": "FAILED" },
                { "key": "target", "value": "DS06" }
              ]
            }
          }
        },
        {
          "name": "List Failed OIC Integrations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/oic/integrations/failed",
              "host": ["{{baseUrl}}"],
              "path": ["oic", "integrations", "failed"]
            }
          }
        },
        {
          "name": "Export Failed OIC Integrations (CSV)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/oic/integrations/failed?format=csv",
              "host": ["{{baseUrl}}"],
              "path": ["oic", "integrations", "failed"],
              "query": [
                { "key": "format", "value": "csv" }
              ]
            }
          }
        },
        {
          "name": "Scenario 2 - Get OIC Instance OIC2006 (Payment Integration)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/oic/integrations/OIC2006",
              "host": ["{{baseUrl}}"],
              "path": ["oic", "integrations", "OIC2006"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Incidents, Retry & Correlation",
      "item": [
        {
          "name": "List All Incidents",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/incidents?page=1&limit=15",
              "host": ["{{baseUrl}}"],
              "path": ["incidents"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "15" }
              ]
            }
          }
        },
        {
          "name": "Filter Open Critical Incidents",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/incidents?status=Open&severity=Critical",
              "host": ["{{baseUrl}}"],
              "path": ["incidents"],
              "query": [
                { "key": "status", "value": "Open" },
                { "key": "severity", "value": "Critical" }
              ]
            }
          }
        },
        {
          "name": "Export Incidents (CSV)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/incidents?format=csv",
              "host": ["{{baseUrl}}"],
              "path": ["incidents"],
              "query": [
                { "key": "format", "value": "csv" }
              ]
            }
          }
        },
        {
          "name": "Scenario 5 - Get Incident INC004 (Exact Fusion->OIC->WMS Correlation)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/incidents/INC004",
              "host": ["{{baseUrl}}"],
              "path": ["incidents", "INC004"]
            }
          }
        },
        {
          "name": "Get Incident INC005 (Payment Integration)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/incidents/INC005",
              "host": ["{{baseUrl}}"],
              "path": ["incidents", "INC005"]
            }
          }
        },
        {
          "name": "Update Incident Status (INC001 -> Investigating)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Investigating\",\n  \"performedBy\": \"ops-engineer\",\n  \"notes\": \"Coordinating with GL team to open NOV-26 period\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/incidents/INC001/status",
              "host": ["{{baseUrl}}"],
              "path": ["incidents", "INC001", "status"]
            }
          }
        },
        {
          "name": "Scenario 4 - Simulate Retry on INC005 (Payment Integration)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"performedBy\": \"ops-engineer\",\n  \"notes\": \"Simulated retry after confirming Banking gateway health\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/incidents/INC005/retry",
              "host": ["{{baseUrl}}"],
              "path": ["incidents", "INC005", "retry"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Event Simulator (DataGeneratorLambda)",
      "item": [
        {
          "name": "Simulate OIC Failure Event",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceType\": \"OIC\",\n  \"forceFailure\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/simulator/tick",
              "host": ["{{baseUrl}}"],
              "path": ["simulator", "tick"]
            }
          }
        },
        {
          "name": "Simulate Random Fusion/OIC Event",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/simulator/tick",
              "host": ["{{baseUrl}}"],
              "path": ["simulator", "tick"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Validation & Negative Cases",
      "item": [
        {
          "name": "Invalid Status Filter (Expect 400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/fusion/jobs?status=INVALID",
              "host": ["{{baseUrl}}"],
              "path": ["fusion", "jobs"],
              "query": [
                { "key": "status", "value": "INVALID" }
              ]
            }
          }
        },
        {
          "name": "Missing Execution ID (Expect 404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/fusion/jobs/FUS9999",
              "host": ["{{baseUrl}}"],
              "path": ["fusion", "jobs", "FUS9999"]
            }
          }
        }
      ]
    }
  ]
}
